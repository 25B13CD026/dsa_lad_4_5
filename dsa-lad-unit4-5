def merge_sort(a):
    if len(a) <= 1:
        return a

    mid = len(a) // 2
    left = merge_sort(a[:mid])
    right = merge_sort(a[mid:])

    return merge(left, right)


def merge(left, right):
    result = []
    i = j = 0

    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    result.extend(left[i:])
    result.extend(right[j:])

    return result


def binary_search(a, target):
    low, high = 0, len(a) - 1
    steps = 0

    while low <= high:
        steps += 1
        mid = (low + high) // 2

        if a[mid] == target:
            return mid, steps
        elif a[mid] < target:
            low = mid + 1
        else:
            high = mid - 1

    return -1, steps


