def find(parent, x):
    while parent[x] != x:
        parent[x] = parent[parent[x]]
        x = parent[x]

    return x


def kruskal(n, edges):
    parent = list(range(n))
    mst, total = [], 0

    for w, u, v in sorted(edges):
        ru, rv = find(parent, u), find(parent, v)

        if ru != rv:
            parent[ru] = rv
            mst.append((u, v, w))
            total += w

            print(f"Add edge {u}-{v} (w={w})")
        else:
            print(f"Skip edge {u}-{v} (w={w}) - forms a cycle")

    return mst, total


