import heapq


def huffman_codes(freq):
    heap = [
        [w, i, [ch, ""]]
        for i, (ch, w) in enumerate(freq.items())
    ]

    heapq.heapify(heap)
    counter = len(heap)

    while len(heap) > 1:
        lo = heapq.heappop(heap)
        hi = heapq.heappop(heap)

        for pair in lo[2:]:
            pair[1] = "0" + pair[1]

        for pair in hi[2:]:
            pair[1] = "1" + pair[1]

        heapq.heappush(
            heap,
            [lo[0] + hi[0], counter] + lo[2:] + hi[2:]
        )

        counter += 1

    return {ch: code for ch, code in heap[0][2:]}


